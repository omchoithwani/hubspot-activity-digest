# HubSpot Private App Access Token (required)
# Create a Private App in HubSpot Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Recipient emails for the daily digest (required)
# Comma-separated list of email addresses
RECIPIENT_EMAILS=admin@yourcompany.com,manager@yourcompany.com

# Sender email address (optional, defaults to digest@aerorev.com)
# Must be a verified sender in your HubSpot account
FROM_EMAIL=digest@yourcompany.com

# Sender display name (optional)
FROM_NAME=AeroRev HubSpot Digest

# Port for the Express health check server (optional, defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Bearer token to protect the manual /trigger endpoint (optional)
# If not set, the /trigger endpoint is open to anyone
TRIGGER_TOKEN=your-secure-random-token-here

# Override recipient for test sends (optional)
# If set, --test mode sends to this address instead of RECIPIENT_EMAILS
TEST_RECIPIENT_EMAIL=developer@yourcompany.com
