# HubSpot OAuth app credentials (from developers.hubspot.com)
HUBSPOT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_REDIRECT_URI=https://your-app.onrender.com/oauth/callback

# HubSpot (legacy / local testing only — production now uses per-tenant OAuth tokens)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=digest@yourdomain.com
FROM_NAME=HubSpot Digest

# Setup page admin token (visit /setup?token=THIS_VALUE)
ADMIN_TOKEN=change-me-to-a-strong-random-string

# Turso database (use a file URL for local dev, Turso cloud URL for production)
TURSO_DATABASE_URL=file:./data/config.db
TURSO_AUTH_TOKEN=

# Public URL of your app (used to generate "View more" links in digest emails)
APP_URL=https://your-app.onrender.com

# Port for the Express server (defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Bearer token to protect POST /trigger (optional)
TRIGGER_TOKEN=your-secure-random-token

# Test recipient for npm run test:digest
TEST_RECIPIENT_EMAIL=om.choithwani@aero-rev.com
